# Healthcare Triage Assistant — Environment Variables Template

# Node Environment & Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/medical_triage

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=1d

# AI Service Provider Credentials (SERVER-SIDE ONLY)
# Google Gemini API Key for LLM Triage Structuring & Summarization
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key for Voice STT and Regional Translation (Hindi & Indian Languages)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Cloud Project & Credentials for Cloud Vision OCR
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,wav,webm
